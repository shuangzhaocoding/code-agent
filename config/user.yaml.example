# Code Agent 用户配置 (~/.code-agent/config.yaml)
# 首次 `make up` 或服务启动时自动生成。修改后需重启服务（make down && make up）。
#
# 优先级：config/default.yaml → 本文件 → 工作区 .code-agent/config.yaml → 设置页

runtime:
  profile: split  # monolith | split
  terminal:
    mode: standalone  # inline | standalone
    host: 127.0.0.1
    port: 4062
  preview:
    mode: standalone  # inline | standalone
    host: 127.0.0.1
    port: 4063

storage:
  database: sqlite  # sqlite | postgres
  events: sqlite  # sqlite | redis（split 模式建议 redis）
  checkpoint: sqlite  # sqlite | postgres
  postgres_url: ""
  redis_url: ""  # 例：redis://127.0.0.1:6379/0
  checkpoint_postgres_url: ""

# 聊天附件上传目录（默认与 SQLite 同属 paths.data_dir）
# uploads:
#   dir: auto  # → ~/.code-agent/data/uploads
#   # dir: ~/.code-agent/data          # 与 sqlite 文件同一目录
#   # dir: /custom/path/uploads        # 绝对路径
# 也可用环境变量：CODE_AGENT_UPLOADS_DIR

# ssh:
#   login_timeout: 20
#   known_hosts: null  # null | auto | /path/to/known_hosts
#   keepalive_interval: 30
#   mirror_ttl_sec: 1800  # SSH plugins/skills mirror cache; 0 = always resync
